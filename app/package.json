{
  "name": "voiceclone-app",
  "version": "1.1.0",
  "private": true,
  "description": "VoiceClone desktop shell (Electron + React)",
  "main": "dist-electron/main.js",
  "scripts": {
    "build:renderer": "vite build",
    "build:main": "node build-main.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "dev:renderer": "vite",
    "dev:main": "npm run build:main && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "fetch:uv": "node scripts/fetch-uv.mjs",
    "dist:mac": "npm run build && node scripts/fetch-uv.mjs darwin-arm64 && electron-builder --mac",
    "dist:win": "npm run build && node scripts/fetch-uv.mjs win32-x64 && electron-builder --win",
    "pack": "npm run build && node scripts/fetch-uv.mjs && electron-builder --dir",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semver": "^7.8.5",
    "wavesurfer.js": "^7.8.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.8",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
