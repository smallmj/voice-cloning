{
  "name": "voiceclone-app",
  "version": "0.1.0",
  "private": true,
  "description": "VoiceClone desktop shell (Electron + React)",
  "main": "dist-electron/main.js",
  "scripts": {
    "build:renderer": "vite build",
    "build:main": "node build-main.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "dev:renderer": "vite",
    "dev:main": "npm run build:main && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wavesurfer.js": "^7.8.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
